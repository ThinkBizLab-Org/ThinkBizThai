{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThinkBizThai Work Package",
  "type": "object",
  "required": ["schema_version", "protocol_version", "work_package_id", "title", "gate", "status", "required_skill_profiles", "role_assignments", "independence", "ownership", "inputs", "outputs", "acceptance_criteria", "required_tests", "deterministic_commands", "security_privacy"],
  "properties": {
    "schema_version": { "type": "string" },
    "protocol_version": { "const": "1.0.0" },
    "work_package_id": { "type": "string", "pattern": "^WP-[A-Za-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "gate": { "type": "string", "minLength": 1 },
    "status": { "enum": ["backlog", "ready", "in_progress", "in_review", "review_approved", "test_verified", "integration_verified", "done", "blocked"] },
    "required_skill_profiles": { "type": "object" },
    "role_assignments": {
      "type": "object",
      "required": ["author_agent_run_id", "reviewer_agent_run_id", "tester_agent_run_id", "integration_owner_agent_run_id"],
      "properties": {
        "author_agent_run_id": { "type": ["string", "null"] },
        "reviewer_agent_run_id": { "type": ["string", "null"] },
        "tester_agent_run_id": { "type": ["string", "null"] },
        "integration_owner_agent_run_id": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "independence": { "type": "object" },
    "ownership": { "type": "object" },
    "inputs": { "type": "object", "required": ["files", "fixtures"], "additionalProperties": true },
    "outputs": { "type": "object", "required": ["files", "contracts"], "additionalProperties": true },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
    "required_tests": { "type": "array", "items": { "type": "string" } },
    "deterministic_commands": { "type": "object", "required": ["setup", "verify", "package_evidence"], "additionalProperties": true },
    "security_privacy": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "enum": ["ready", "in_progress", "in_review", "review_approved", "test_verified", "integration_verified", "done"] }
        }
      },
      "then": {
        "properties": {
          "role_assignments": {
            "properties": {
              "author_agent_run_id": { "type": "string", "minLength": 1 },
              "reviewer_agent_run_id": { "type": "string", "minLength": 1 },
              "tester_agent_run_id": { "type": "string", "minLength": 1 },
              "integration_owner_agent_run_id": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
