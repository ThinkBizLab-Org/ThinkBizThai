{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThinkBizThai Work Package Handoff",
  "type": "object",
  "required": ["schema_version", "protocol_version", "work_package_id", "agent_run_id", "final_status", "base_revision", "head_revision_or_patch_checksum", "task_ids", "files_added", "files_modified", "files_deleted", "decisions_consumed", "contracts_consumed", "contracts_produced_or_changed", "assumptions", "acceptance_results", "tests", "security_privacy_cost_impact", "migration_and_data_impact", "compatibility_impact", "known_limitations", "open_risks_or_blockers", "rollback_or_forward_fix", "recommended_next_work_packages", "reviewer_instructions"],
  "properties": {
    "schema_version": { "type": "string" },
    "protocol_version": { "const": "1.0.0" },
    "work_package_id": { "type": "string" },
    "agent_run_id": { "type": "string", "minLength": 1 },
    "final_status": { "type": "string" },
    "base_revision": { "type": "string", "minLength": 1 },
    "head_revision_or_patch_checksum": { "type": "string", "minLength": 1 },
    "task_ids": { "type": "array", "items": { "type": "string" } },
    "files_added": { "type": "array", "items": { "type": "string" } },
    "files_modified": { "type": "array", "items": { "type": "string" } },
    "files_deleted": { "type": "array", "items": { "type": "string" } },
    "decisions_consumed": { "type": "array", "items": { "type": "string" } },
    "contracts_consumed": { "type": "array", "items": { "type": "string" } },
    "contracts_produced_or_changed": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "acceptance_results": { "type": "array", "items": { "type": "object" } },
    "tests": { "type": "array", "items": { "type": "object" } },
    "security_privacy_cost_impact": { "type": "string" },
    "migration_and_data_impact": { "type": "string" },
    "compatibility_impact": { "type": "string" },
    "known_limitations": { "type": "array", "items": { "type": "string" } },
    "open_risks_or_blockers": { "type": "array", "items": { "type": "string" } },
    "rollback_or_forward_fix": { "type": "string" },
    "recommended_next_work_packages": { "type": "array", "items": { "type": "string" } },
    "reviewer_instructions": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
