{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"CTR-IDM-001","title":"Command idempotency record","type":"object","additionalProperties":false,"required":["idempotency_key","scope","payload_hash","state","created_at"],"properties":{"idempotency_key":{"type":"string","minLength":1},"scope":{"type":"object","additionalProperties":false,"required":["workspace_id","operation"],"properties":{"workspace_id":{"type":"string","minLength":1},"operation":{"type":"string","minLength":1,"pattern":"^[a-z0-9]+(\\.[a-z0-9]+)+$"}}},"payload_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"state":{"enum":["in_progress","completed","failed"]},"created_at":{"type":"string","format":"date-time"},"completed_at":{"type":"string","format":"date-time"},"result_ref":{"type":"string","minLength":1,"pattern":"^(?!https?://).+"},"error":{"$ref":"../ctr-err-001/schema.json"},"correlation_id":{"type":"string","minLength":1}},"allOf":[{"if":{"properties":{"state":{"const":"completed"}}},"then":{"required":["completed_at","result_ref"],"not":{"required":["error"]}}},{"if":{"properties":{"state":{"const":"failed"}}},"then":{"required":["completed_at","error"],"not":{"required":["result_ref"]}}},{"if":{"properties":{"state":{"const":"in_progress"}}},"then":{"not":{"anyOf":[{"required":["result_ref"]},{"required":["error"]},{"required":["completed_at"]}]}}}]}
