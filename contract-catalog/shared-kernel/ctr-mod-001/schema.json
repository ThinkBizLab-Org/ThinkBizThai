{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"CTR-MOD-001","title":"Module Manifest and Lifecycle","type":"object","additionalProperties":false,"required":["module_key","module_id","version","owner_role","capabilities","dependencies","permissions","cost_policy","data_policy","lifecycle"],"properties":{"module_key":{"type":"string","pattern":"^[a-z][a-z0-9-]*$","x-source":"MR-001 rejects a duplicate key; the registry resolves modules by this key."},"module_id":{"type":"string","pattern":"^MOD-[0-9]{3}$","x-source":"Decision Register section 5.1 module registry (MOD-000..MOD-140)."},"version":{"type":"string","pattern":"^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$","x-source":"MR-001 rejects an invalid semver."},"owner_role":{"enum":["A0","A1","A2","A3","A4","A5","A6"],"x-source":"Decision Register section 5.1 assigns one owner role per module."},"capabilities":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["capability_key","version"],"properties":{"capability_key":{"type":"string","pattern":"^[a-z][a-z0-9.]*$"},"version":{"type":"integer","minimum":1}}},"x-source":"MR-002 requires deterministic resolution of a duplicate capability, so a capability is keyed and versioned."},"dependencies":{"type":"array","uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["module_key","range"],"properties":{"module_key":{"type":"string","pattern":"^[a-z][a-z0-9-]*$"},"range":{"type":"string","minLength":1}}},"x-source":"MR-003 blocks a circular, missing or incompatible dependency with a stable error."},"permissions":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1},"x-source":"MR-001 rejects a manifest missing its permission policy."},"cost_policy":{"type":"object","additionalProperties":false,"required":["metered"],"properties":{"metered":{"type":"boolean"},"usage_contract":{"type":"string","pattern":"^CTR-[A-Z]{3}-[0-9]{3}$"}},"x-source":